# ============================================================
# TTC-Back — environment variable template
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# ============================================================

# ----- App -----
ENV=local                     # local | prod

# ----- Database -----
POSTGRES_USER=mylocaldb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mylocaldb
# The connection URL is derived from POSTGRES_* + DB_HOST + DB_PORT (see app/core/config.py).
# Local PostgreSQL: 5432.  `docker compose up -d db` publishes it on 5434.
# (docker-compose forces DB_HOST=db / DB_PORT=5432 inside the containers.)
DB_PORT=5432

# ----- Security -----
JWT_SECRET_KEY=change-me-min-32-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEPLOY_SECRET=change-me

# ----- External APIs -----
STIB_API_KEY=change-me
TEC_API_KEY=change-me

# ----- Cloudflare Turnstile (captcha) -----
TURNSTILE_SECRET_KEY=change-me

# ----- Mail -----
MAIL_USERNAME=admin@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=admin@example.com
MAIL_SERVER=mail.example.com
MAIL_PORT=465
MAIL_SSL_TLS=true
MAIL_STARTTLS=false

# ----- Stripe -----
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Run: stripe listen --forward-to localhost:8000/api/payments/webhook
# to get a local webhook secret during development
STRIPE_WEBHOOK_SECRET=whsec_...


# ----- Firmware storage -----
# Local dev: a folder in the repo (gitignored).
# Production/Docker: /data/firmware (docker-compose mounts ./firmware_packages there).
FIRMWARE_DIR=./data/firmware

# ----- Blog artifact embeds -----
# Local dev: a folder in the repo (gitignored).
# Production/Docker: /data/blog-embeds (docker-compose mounts ./blog_embeds there).
BLOG_EMBEDS_DIR=./data/blog-embeds

# ----- URLs -----
# Local dev  : FRONTEND_URL=http://localhost:4200
# Production : FRONTEND_URL=https://transport.trillet.be
FRONTEND_URL=http://localhost:4200

# Local dev  : API_BASE_URL=http://localhost:8000
# Production : API_BASE_URL=https://transport.trillet.be/api  (or reverse-proxied)
# Only used by the PM2 local config (it writes it into ../TTC-Front/public/runtime-env.js).
API_BASE_URL=http://localhost:8000


# google auth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# ----- Device mTLS provisioning -----
# Shared secret between this server and the home-server enrollment proxy.
# Generate with: openssl rand -hex 32
# Leave empty locally — the provisioning endpoint requires it in production.
HOME_SERVER_SECRET=
# Paths inside the Docker container (mounted from ./ca/intermediate/ by docker-compose).
# Only change if you restructure the CA directory.
DEVICE_CA_KEY_PATH=/etc/device-ca/inter.key
DEVICE_CA_CERT_PATH=/etc/device-ca/inter.crt

# ----- SendCloud (shipping) -----
# Create an integration in SendCloud panel → Settings → Integrations.
# Use "Sandbox" credentials locally, "Live" credentials in production.
# Leave all empty to disable the Ship button (orders can still be shipped manually).
SENDCLOUD_API_KEY=
SENDCLOUD_API_SECRET=

# Sender address ID: SendCloud panel → Settings → Addresses → hover an address for its ID
SENDCLOUD_FROM_ADDRESS_ID=0

# Push notifications (departure alerts): path to the Firebase service-account
# JSON. Docker sets it to /run/secrets/firebase-admin.json (mounted from
# ./secrets/, never committed). Empty = notifications disabled.
FIREBASE_CREDENTIALS_FILE=
