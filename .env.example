# ============================================================
# server-STIB — environment variable template
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# ============================================================

# ----- App -----
ENV=local                     # local | prod

# ----- Database -----
POSTGRES_USER=mylocaldb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mylocaldb
# For PM2/direct runs. Docker Compose builds this from POSTGRES_* above.
DATABASE_URL=postgresql+psycopg2://mylocaldb:change-me@localhost:5432/mylocaldb

# ----- Security -----
JWT_SECRET_KEY=change-me-min-32-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEPLOY_SECRET=change-me

# ----- External APIs -----
STIB_API_KEY=change-me
TEC_API_KEY=change-me
TURNSTILE_SECRET_KEY=change-me

# ----- Mail -----
MAIL_USERNAME=admin@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=admin@example.com
MAIL_SERVER=mail.example.com
MAIL_PORT=465
MAIL_SSL_TLS=true
MAIL_STARTTLS=false

# ----- Stripe -----
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Run: stripe listen --forward-to localhost:8000/api/payments/webhook
# to get a local webhook secret during development
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- URLs -----
# Local dev  : FRONTEND_URL=http://localhost:4200
# Production : FRONTEND_URL=https://transport.trillet.be
FRONTEND_URL=http://localhost:4200

# Local dev  : API_BASE_URL=http://localhost:8000
# Production : API_BASE_URL=https://transport.trillet.be/api  (or reverse-proxied)
# After changing this run: node scripts/gen-runtime-env.js
API_BASE_URL=http://localhost:8000
